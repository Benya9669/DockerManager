# Copy to .env and adjust
DM_PORT=8000
DM_ADMIN_USERNAME=admin
# Leave empty to generate a random one (printed to logs and saved to /data/initial_admin_password.txt)
DM_ADMIN_PASSWORD=
# Leave empty to auto-generate and persist in /data/secret.key
DM_SECRET_KEY=
# External URL (used to display webhook URLs), e.g. https://docker.company.ru
DM_PUBLIC_URL=
# Where git projects are cloned on the host (mounted at the same path)
DM_PROJECTS_DIR=/opt/dockermanager/projects
# Folder with SSH keys (id_ed25519, known_hosts) for git@ repos
DM_SSH_DIR=./ssh
# Optional Postgres instead of SQLite: postgresql+psycopg://user:pass@host:5432/dockermanager
DM_DATABASE_URL=
# Allow admins to register existing host folders as projects
DM_ALLOW_LOCAL_PATHS=true
# Scheduled cleanup: every N hours prune stopped containers / dangling images / build cache older than M hours (0 = off)
DM_AUTO_PRUNE_INTERVAL_HOURS=0
DM_AUTO_PRUNE_OLDER_THAN_HOURS=72
