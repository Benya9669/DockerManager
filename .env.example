# Copy to .env and adjust
DM_PORT=8000
DM_ADMIN_USERNAME=admin
# Leave empty to generate a random one (printed to logs and saved to /data/initial_admin_password.txt)
DM_ADMIN_PASSWORD=
# Leave empty to auto-generate and persist in /data/secret.key
DM_SECRET_KEY=
# External URL (used to display webhook URLs), e.g. https://docker.company.ru
DM_PUBLIC_URL=
# Where git projects are cloned on the host (mounted at the same path)
DM_PROJECTS_DIR=/opt/dockermanager/projects
# Folder with SSH keys (id_ed25519, known_hosts) for git@ repos
DM_SSH_DIR=./ssh
# Optional Postgres instead of SQLite: postgresql+psycopg://user:pass@host:5432/dockermanager
DM_DATABASE_URL=
# Allow admins to register existing host folders as projects
DM_ALLOW_LOCAL_PATHS=true
# Scheduled cleanup: every N hours prune stopped containers / dangling images / build cache older than M hours (0 = off)
DM_AUTO_PRUNE_INTERVAL_HOURS=0
DM_AUTO_PRUNE_OLDER_THAN_HOURS=72

# ---- Self-update (checks GitHub Releases of DM_UPDATE_REPO) ----
# git   = git pull this repo + rebuild image locally (no registry needed)
# image = pull ghcr.io/benya9669/dockermanager:${DM_IMAGE_TAG} (add ghcr.io in panel -> Registries if private)
DM_UPDATE_MODE=git
DM_IMAGE_TAG=latest
DM_UPDATE_REPO=Benya9669/DockerManager
# Required for a private repo: fine-grained PAT with read access to Contents (to read releases)
DM_UPDATE_GITHUB_TOKEN=
# SSH key file name (in DM_SSH_DIR) with read access to this repo, for git mode
DM_UPDATE_SSH_KEY=
# Update automatically when a new release appears
DM_AUTO_UPDATE=false
DM_UPDATE_CHECK_HOURS=6

# Bind to localhost only and expose via reverse proxy (npmplus): DM_PORT=127.0.0.1:8000

# ---- Monitoring ----
DM_METRICS_INTERVAL=30
DM_METRICS_RETENTION_HOURS=24

# ---- Backups (archives are kept in /data/backups inside the dm-data volume) ----
DM_BACKUP_INTERVAL_HOURS=0
DM_BACKUP_KEEP=7
DM_BACKUP_STOP_CONTAINERS=false
